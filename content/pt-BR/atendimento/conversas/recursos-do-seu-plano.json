        },
        {
          "question": "Respondi um cliente e a conversa não ficou comigo. Por quê?",
          "answer": [
            {
              "type": "paragraph",
              "content": "No atendimento básico, responder não deixa a conversa com ninguém. Ela continua em Todos, visível para a equipe."
            }
