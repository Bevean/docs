        ],
        [
          {
            "content": "Próximas"
          },
          {
            "content": "O que você agendou ou reagendou para um dia que ainda não chegou, e tarefas com prazo depois da semana. A lista vem agrupada por dia."
          }
        ],
        [
          {
            "content": "Atrasadas"
          },
          {
            "content": "Tarefas abertas com o prazo vencido."
          }
        ],
        [
          {
            "content": "Concluídas"
