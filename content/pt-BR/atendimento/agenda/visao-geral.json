          {
            "content": "Qualquer atendente"
          },
          {
            "content": "Não"
          }
        ],
        [
          {
            "content": [
              {
                "type": "text",
                "text": "Tarefa de campanha",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " — criada por uma automação ou disparo, com o passo "
              },
              {
                "type": "text",
                "text": "Agenda do vendedor",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              }
            ]
          },
          {
            "content": "Vendedores com assento na Agenda"
          },
          {
            "content": "Sim"
          }
        ]
      ]
    },
