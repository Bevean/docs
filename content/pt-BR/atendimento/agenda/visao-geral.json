            {
              "type": "text",
              "text": "Agenda da equipe",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": ", no Painel — veja "
            },
            {
              "type": "text",
              "text": "Acompanhar a equipe",
              "marks": [
                {
                  "type": "docLink",
                  "attrs": {
                    "ref": "atendimento/agenda/acompanhar-a-equipe"
