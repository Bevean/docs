                ]
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "text",
                "text": "descartada",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " ou "
              },
