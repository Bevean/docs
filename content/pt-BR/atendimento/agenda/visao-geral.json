                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": ", dentro de uma conversa"
              }
            ]
          },
          {
            "content": "Qualquer atendente"
          },
          {
            "content": "Não"
          }
