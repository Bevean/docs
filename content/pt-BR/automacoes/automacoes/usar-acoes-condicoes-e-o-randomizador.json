                  }
                ]
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ],
        [
          {
            "content": "Horário"
          },
          {
            "content": "Se o horário atual está dentro ou fora de uma grade de dias e faixas. Veja abaixo."
          }
        ],
        [
          {
            "content": "Engajamento neste fluxo"
          },
          {
            "content": "Se respondeu, clicou, abriu, recebeu ou falhou um envio anterior deste mesmo fluxo."
