        ],
        [
          {
            "content": "Pausado"
          },
          {
            "content": "Parou de aceitar novos contatos. Quem já está dentro continua andando."
          }
        ],
        [
          {
            "content": "Cancelado"
          },
          {
            "content": "Parado por completo — inclusive quem estava em andamento. Não tem volta."
