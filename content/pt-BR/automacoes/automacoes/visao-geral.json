          ]
        },
        {
          "type": "text",
          "text": " e "
        },
        {
          "type": "text",
          "text": "montar o fluxo",
          "marks": [
            {
              "type": "docLink",
              "attrs": {
                "ref": "automacoes/automacoes/montar-o-fluxo"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "content": "Estados de uma automação"
    },
    {
      "type": "table",
      "head": [
        {
          "content": "Estado"
        },
        {
          "content": "Significado"
        }
      ],
      "rows": [
        [
          {
            "content": "Rascunho"
          },
          {
            "content": "Ainda sendo montada, nunca publicada."
          }
        ],
        [
          {
            "content": "Publicado / Ativo"
          },
          {
            "content": "Rodando — todo novo contato que se enquadrar no gatilho entra no fluxo."
