        },
        {
          "ref": "conteudos/pedidos-e-carrinhos/editar-o-status-de-um-pedido",
          "description": "Mude o status de pagamento, entrega ou do pedido em si."
        }
      ],
      "title": "Próximos passos"
    }
  ]
