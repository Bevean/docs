{
  "$schema": "../../../../.vscode/schemas/article.schema.json",
  "title": "Criar um modelo de e-mail",
  "subtitle": "Os blocos do editor visual, as preferências gerais e o modo avançado de HTML.",
  "updatedAt": "2026-10-16",
  "tags": [
    "editor de e-mail",
