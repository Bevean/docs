    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "No fim do editor, "
        },
        {
          "type": "text",
          "text": "Excluir",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "type": "text",
          "text": " tira o chat do ar em todo lugar onde ele aparece. As conversas já recebidas continuam no Atendimento."
        }
      ]
    },
    {
      "type": "heading",
