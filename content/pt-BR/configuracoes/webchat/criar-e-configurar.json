{
  "$schema": "../../../../.vscode/schemas/article.schema.json",
  "title": "Criar e configurar um Webchat",
  "subtitle": "Crie o chat, escolha onde ele aparece e ajuste aparência, textos, menu do botão e segurança.",
  "updatedAt": "2026-10-13",
  "tags": [
    "criar chat",
    "botão flutuante",
    "menu do botão",
    "pré-chat",
    "cor do chat",
    "ícone do chat"
  ],
  "related": [
    "configuracoes/webchat/visao-geral",
