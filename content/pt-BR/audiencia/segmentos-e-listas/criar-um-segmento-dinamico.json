{
  "$schema": "../../../../.vscode/schemas/article.schema.json",
  "title": "Criar um segmento dinâmico",
  "subtitle": "O passo a passo do filtro e a lista completa de condições disponíveis, por grupo.",
  "updatedAt": "2026-09-03",
  "tags": [
    "criar segmento",
    "condições",
    "filtro dinâmico",
    "segmentação"
  ],
