    {
      "type": "list",
      "style": "bullet",
      "items": [
        {
          "content": "O tipo da propriedade define o tipo do campo no formulário: texto, número, aceite, data ou lista."
        },
        {
          "content": [
            {
              "type": "text",
              "text": "O botão "
