        ],
        [
          {
            "content": "Vencido"
          },
          {
            "content": "Passou da validade sem ser usado. Não volta"
          }
        ],
        [
          {
            "content": "Cancelado"
          },
          {
            "content": "Deixou de valer: o pedido que o gerou caiu, ou um giftback mais novo o substituiu. O motivo aparece embaixo da situação"
          }
        ],
        [
          {
            "content": "Falhou"
          },
          {
            "content": "A Bevean não conseguiu criar o cupom na loja. O motivo aparece embaixo e dá para tentar de novo"
