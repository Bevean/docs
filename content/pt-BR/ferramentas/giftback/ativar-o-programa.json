        {
          "type": "text",
          "text": "começa a contar quando o cupom é criado",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "type": "text",
          "text": ", não na compra. Carência de 7 dias com validade de 30 dá 37 dias entre a aprovação do pedido e o vencimento do cupom."
        }
      ]
    },
