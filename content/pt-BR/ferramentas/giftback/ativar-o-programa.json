      "rows": [
        [
          {
            "content": "Produtos (sem frete)"
          },
          {
            "content": "Só os produtos, já com os descontos abatidos. O frete fica de fora"
          }
        ],
        [
          {
            "content": "Total pago"
          },
          {
            "content": "O valor cheio do pedido, frete incluído"
          }
        ]
      ]
    },
    {
      "type": "callout",
      "variant": "info",
      "body": [
        {
          "type": "paragraph",
          "content": "Um pedido de R$ 200 com R$ 50 de desconto gera giftback sobre R$ 150."
        }
      ],
      "title": "Desconto no pedido reduz o giftback na base Produtos"
    },
    {
      "type": "callout",
      "variant": "warning",
      "body": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Com a base "
            },
            {
              "type": "text",
              "text": "Produtos (sem frete)",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": ", um pedido de R$ 110 com R$ 20 de frete vale R$ 90 na comparação. Com compra mínima de R$ 100, ele não gera giftback."
            }
          ]
        }
      ],
      "title": "A compra mínima é comparada com a base de cálculo"
    },
    {
      "type": "heading",
      "level": 2,
      "content": "Quando o cupom nasce e por quanto tempo vale"
    },
    {
      "type": "table",
      "head": [
        {
          "content": "Campo"
        },
        {
          "content": "O que faz"
