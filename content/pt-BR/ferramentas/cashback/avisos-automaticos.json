          }
        ],
        [
          {
            "content": "Crédito expirando"
          },
          {
            "content": "Falta para o vencimento um dos dias que a automação definiu (ou uma das antecedências do cashback)"
          },
          {
            "content": "O lembrete que evita a perda do saldo"
          }
        ],
        [
          {
            "content": "Cashback resgatado"
          },
          {
            "content": "O cliente conclui um resgate"
          },
          {
            "content": "Entregar o código do cupom e lembrar do prazo"
