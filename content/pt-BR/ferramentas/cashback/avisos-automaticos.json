        }
      ],
      "rows": [
        [
          {
            "content": "Nova entrada de crédito"
          },
          {
            "content": "Um crédito é lançado no nome do cliente"
          },
          {
            "content": "Avisar na hora da compra: “você acabou de ganhar…”"
