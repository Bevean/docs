{
  "$schema": "../../../../../.vscode/schemas/article.schema.json",
  "title": "Instalar o script na Shopify",
  "subtitle": "O Custom Pixel em Eventos do cliente e o código do tema em theme.liquid: dois códigos, cada um num lugar.",
  "updatedAt": "2026-09-29",
  "tags": [
    "Custom Pixel",
    "pixel",
    "tema",
    "theme.liquid",
    "tracker",
    "eventos do cliente"
