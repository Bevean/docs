                "type": "text",
                "text": "Webhooks instalados corretamente",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              }
            ]
          },
          {
            "content": "Todos os avisos dos tipos de dado ligados estão registrados na Nuvemshop"
          },
          {
            "content": "Nada"
          }
        ],
        [
          {
            "content": [
              {
