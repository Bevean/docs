              "type": "bold"
            }
          ]
        },
        {
          "type": "text",
          "text": " e clique em "
        },
        {
          "type": "text",
          "text": "Conectar",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "type": "text",
          "text": ". A Bevean valida as credenciais na hora."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "content": "O que é sincronizado"
    },
    {
      "type": "paragraph",
      "content": "Clientes, Pedidos e Produtos. A Bevean busca os dados de todas as lojas da conta do GestãoClick, não só da loja matriz, sem você precisar escolher."
    },
    {
      "type": "callout",
      "variant": "info",
      "body": [
        {
          "type": "paragraph",
          "content": "O GestãoClick não envia avisos automáticos de pedido ou de cliente. As novidades aparecem a cada ciclo de sincronização, não no mesmo instante."
        }
      ],
      "title": "Os dados chegam pela sincronização periódica"
    },
