    {
      "type": "heading",
      "level": 2,
      "content": "Gerar as credenciais na VTEX"
    },
    {
      "type": "steps",
      "items": [
        {
          "title": "No Admin da VTEX, acesse Configurações da conta › Chaves de API"
        },
        {
          "title": "Crie uma nova chave de API"
        },
        {
          "title": "Copie três valores",
          "body": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Account",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " — o nome da conta VTEX, sem espaço e sem o sufixo "
                },
                {
                  "type": "text",
                  "text": ".myvtex.com",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "App Key",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " e "
                },
                {
                  "type": "text",
                  "text": "App Token",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " — gerados junto com a chave."
                }
              ]
            }
