{
  "name": "bevean-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts && pnpm check:bundle",
    "preview": "vite preview",
    "prepare": "pnpm content:schema",
    "content:check": "tsx scripts/content-validate.ts && tsx scripts/check-docs-examples.ts",
    "content:generate": "tsx scripts/content-generate.ts",
    "content:new": "tsx scripts/content-new.ts",
    "content:schema": "tsx scripts/content-json-schema.ts",
    "check:docs": "tsx scripts/check-docs-examples.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "predev": "pnpm content:generate",
    "prebuild": "pnpm content:generate",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "minisearch": "^7.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-glob": "^3.3.3",
    "globals": "^17.12.0",
    "image-size": "^2.0.2",
    "json-source-map": "^0.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.5.4"
  }
}
